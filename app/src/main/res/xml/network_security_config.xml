<?xml version="1.0" encoding="utf-8"?>
<!-- the add-on runs in the home LAN: plain HTTP is allowed; HTTPS with a self-signed certificate is pinned by the app on first use -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
